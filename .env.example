# Copy this file to .env and adjust as needed.

# Host directory to share files with DingTalk (default: /tmp)
# DINGTALK_DOWNLOADS=~/Downloads

# Host directory for persistent config/login data (default: ~/.config/dingtalk-docker)
# DINGTALK_CONFIG=~/.config/dingtalk-docker

# Your host UID, used to locate the PulseAudio socket (default: 1000)
# HOST_UID=1000

# PulseAudio cookie path (default: ~/.config/pulse/cookie)
# PULSE_COOKIE=~/.config/pulse/cookie
